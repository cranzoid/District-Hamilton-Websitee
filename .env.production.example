APP_NAME="District Tapas Bar & Restaurant"
APP_ENV=production
APP_KEY=                          # REQUIRED — php artisan key:generate
APP_DEBUG=false
APP_URL=https://district-tapas.com

APP_TIMEZONE=America/Toronto
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/district-hamilton/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=district-tapas.com

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp                  # REQUIRED — smtp | ses | mailgun
MAIL_HOST=                        # REQUIRED
MAIL_PORT=587
MAIL_USERNAME=                    # REQUIRED
MAIL_PASSWORD=                    # REQUIRED
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@district-tapas.com
MAIL_FROM_NAME="District Tapas Bar & Restaurant"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_KEY=                       # REQUIRED — pk_live_…
STRIPE_SECRET=                    # REQUIRED — sk_live_…
STRIPE_WEBHOOK_SECRET=            # REQUIRED — whsec_… from Stripe Dashboard

VITE_STRIPE_KEY="${STRIPE_KEY}"

# ── Restaurant ────────────────────────────────────────────────────────────────
RESTAURANT_NAME="The District Tapas Bar & Restaurant"
RESTAURANT_ADDRESS="202 King St. East, Hamilton, ON L8N 1B5"
RESTAURANT_PHONE="(905) 525-0779"
RESTAURANT_EMAIL=info@district-tapas.com
RESTAURANT_WEBSITE=https://district-tapas.com
ADMIN_EMAIL=                      # REQUIRED — kitchen notification recipient

RESTAURANT_FACEBOOK=https://facebook.com/districttapas
RESTAURANT_INSTAGRAM=https://instagram.com/districttapas
RESTAURANT_TWITTER=https://twitter.com/districttapas
