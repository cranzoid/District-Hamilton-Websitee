[Unit]
Description=Laravel Queue Worker — District Hamilton
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/district-hamilton
ExecStart=/usr/bin/php8.2 artisan queue:work database \
    --sleep=3 \
    --tries=3 \
    --max-time=3600
Restart=always
RestartSec=5

StandardOutput=append:/var/log/laravel-queue.log
StandardError=append:/var/log/laravel-queue.log

[Install]
WantedBy=multi-user.target
